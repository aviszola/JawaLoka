<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.NestedScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:context=".activity.PenggunaanKramaActivity"
        tools:showIn="@layout/activity_penggunaan_krama">

    <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="16dp">

        <TextView
                android:lineSpacingExtra="5sp"
                android:id="@+id/definisi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:text="@string/definisi_krama"
                android:textColor="#332c2b" />

        <ImageView
                android:id="@+id/gambar_krama"
                android:layout_marginTop="10dp"
                android:layout_below="@id/definisi"
                android:layout_centerHorizontal="true"
                android:src="@drawable/gambar_krama"
                android:layout_width="352dp"
                android:layout_height="200dp"/>
        <TextView
                android:lineSpacingExtra="5sp"
                android:layout_marginTop="10dp"
                android:layout_below="@id/gambar_krama"
                android:id="@+id/krama_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:text="@string/krama2"
                android:textColor="#332c2b" />
        <ImageView

                android:layout_marginTop="15dp"
                android:layout_below="@id/krama_2"
                android:src="@drawable/no_1"
                android:id="@+id/no1"
                android:layout_width="25dp"
                android:layout_height="25dp"/>
        <TextView
                android:layout_marginLeft="5sp"
                android:layout_marginTop="15dp"
                android:layout_toRightOf="@id/no1"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/krama_2"
                android:id="@+id/contoh1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:text="Krama Lugu"
                android:textColor="#00314c"
                android:layout_toEndOf="@id/no1"/>
        <TextView
                android:layout_margin="5dp"
                android:layout_toRightOf="@id/no1"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/contoh1"
                android:id="@+id/krama_lugu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:text="@string/krama_lugu"
                android:textColor="#332c2b"
                android:layout_toEndOf="@id/no1"/>
        <TextView
                android:layout_margin="5dp"
                android:padding="5sp"
                android:layout_toRightOf="@id/no1"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/krama_lugu"
                android:id="@+id/krama_lugu_1"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:textSize="13sp"
                android:background="#d9f1ff"
                android:text="1. Orang yang sederajat tetapi saling menghormati"
                android:textColor="#332c2b"
                android:layout_toEndOf="@id/no1"/>
        <TextView
                android:layout_margin="5dp"
                android:padding="5sp"
                android:layout_toRightOf="@id/no1"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/krama_lugu_1"
                android:id="@+id/krama_lugu_2"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:textSize="13sp"
                android:background="#d9f1ff"
                android:text="2. Orang yang baru kenal dan belum terlalu akrab
"
                android:textColor="#332c2b"
                android:layout_toEndOf="@id/no1"/>
        <TextView
                android:layout_margin="5dp"
                android:padding="5sp"
                android:layout_toRightOf="@id/no1"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/krama_lugu_2"
                android:id="@+id/krama_lugu_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:background="#d9f1ff"
                android:text="3. Mengisi acara resmi "
                android:textColor="#332c2b"
                android:layout_toEndOf="@id/no1"/>
        <TextView
                android:lineSpacingExtra="5sp"
                android:layout_marginTop="10dp"
                android:layout_below="@id/krama_lugu_3"
                android:id="@+id/contoh_penggunaan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:text="@string/contoh_penggunaan_krama"
                android:textColor="#332c2b" />

        <RelativeLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/contoh_penggunaan"
                        android:background="#fcffd9"
                        android:id="@+id/contoh_krama_lugu1"
                        android:layout_marginTop="5sp"
        >
            <ImageView
                    android:layout_gravity="top|start"
                    android:src="@drawable/contoh_1"
                    android:id="@+id/ic_contoh_1"
                    android:layout_width="25dp"
                    android:layout_height="25dp"/>
            <TextView
                    android:layout_margin="5dp"
                    android:lineSpacingExtra="5sp"
                    android:id="@+id/contoh_krama_lugu_1"
                    android:layout_toRightOf="@id/ic_contoh_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:text="@string/contoh_krama_lugu_1"
                    android:textColor="#00314c"/>
            <TextView
                    android:layout_margin="5dp"
                    android:lineSpacingExtra="5sp"
                    android:id="@+id/arti_contoh_krama_lugu_1"
                    android:layout_below="@id/contoh_krama_lugu_1"
                    android:layout_toRightOf="@id/ic_contoh_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:text="@string/arti_contoh_krama_lugu_1"
                    android:textColor="#9a9a9a"/>

        </RelativeLayout>

        <RelativeLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/contoh_krama_lugu1"
                        android:background="#fcffd9"
                        android:id="@+id/contoh_krama_lugu2"
                        android:layout_marginTop="5sp"
        >
            <ImageView
                    android:layout_gravity="top|start"
                    android:src="@drawable/contoh_2"
                    android:id="@+id/ic_contoh_2"
                    android:layout_width="25dp"
                    android:layout_height="25dp"/>
            <TextView
                    android:layout_margin="5dp"
                    android:lineSpacingExtra="5sp"
                    android:id="@+id/contoh_krama_lugu_2"
                    android:layout_toRightOf="@id/ic_contoh_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:text="@string/contoh_krama_lugu_2"
                    android:textColor="#00314c"/>
            <TextView
                    android:layout_margin="5dp"
                    android:lineSpacingExtra="5sp"
                    android:id="@+id/arti_contoh_krama_lugu_2"
                    android:layout_below="@id/contoh_krama_lugu_2"
                    android:layout_toRightOf="@id/ic_contoh_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:text="@string/arti_contoh_krama_lugu_2"
                    android:textColor="#9a9a9a"/>

        </RelativeLayout>

        <RelativeLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/contoh_krama_lugu2"
                        android:background="#fcffd9"
                        android:id="@+id/contoh_krama_lugu3"
                        android:layout_marginTop="5sp"
        >
            <ImageView
                    android:layout_gravity="top|start"
                    android:src="@drawable/contoh_3"
                    android:id="@+id/ic_contoh_3"
                    android:layout_width="25dp"
                    android:layout_height="25dp"/>
            <TextView
                    android:layout_margin="5dp"
                    android:lineSpacingExtra="5sp"
                    android:id="@+id/contoh_krama_lugu_3"
                    android:layout_toRightOf="@id/ic_contoh_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:text="@string/contoh_krama_lugu_3"
                    android:textColor="#00314c"/>
            <TextView
                    android:layout_margin="5dp"
                    android:lineSpacingExtra="5sp"
                    android:id="@+id/arti_contoh_krama_lugu_3"
                    android:layout_below="@id/contoh_krama_lugu_3"
                    android:layout_toRightOf="@id/ic_contoh_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:text="@string/arti_contoh_krama_lugu_3"
                    android:textColor="#9a9a9a"/>
        </RelativeLayout>

        <!---->
        <!--B A T A S KNFNVJNDFJNJVNJSVNDFJKVKJVNSJKDVNJKSDVJKVJKVNDVNJK-->

        <ImageView
                android:layout_marginTop="15dp"
                android:layout_below="@id/contoh_krama_lugu3"
                android:src="@drawable/no_2"
                android:id="@+id/no2"
                android:layout_width="25dp"
                android:layout_height="25dp"/>
        <TextView
                android:layout_marginTop="15dp"
                android:layout_marginLeft="5dp"
                android:layout_toRightOf="@id/no2"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/contoh_krama_lugu3"
                android:id="@+id/contoh2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:text="Krama Inggil"
                android:textColor="#00314c"
                android:layout_toEndOf="@id/no2"/>
        <TextView
                android:layout_margin="5dp"
                android:layout_toRightOf="@id/no2"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/contoh2"
                android:id="@+id/krama_inggil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:text="@string/krama_inggil"
                android:textColor="#332c2b"
                android:layout_toEndOf="@id/no2"/>
        <TextView
                android:layout_margin="5dp"
                android:padding="5sp"
                android:layout_toRightOf="@id/no2"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/krama_inggil"
                android:id="@+id/krama_inggil_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:background="#d9f1ff"
                android:text="1. Orang yang sederajat tetapi saling sangat menghormati.
"
                android:textColor="#332c2b"
                android:layout_toEndOf="@id/no2"/>

        <TextView
                android:layout_margin="5dp"
                android:padding="5sp"
                android:layout_toRightOf="@id/no2"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/krama_inggil_1"
                android:id="@+id/krama_inggil_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:background="#d9f1ff"
                android:text="2. Orang yang lebih tinggi derajatnya (anak kepada orang tua, murid kepada guru)"
                android:textColor="#332c2b"
                android:layout_toEndOf="@id/no2"/>

        <TextView
                android:layout_margin="5dp"
                android:padding="5sp"
                android:layout_toRightOf="@id/no2"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/krama_inggil_2"
                android:id="@+id/krama_inggil_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:background="#d9f1ff"
                android:text="3. Sesepuh yang sangat dihormati"
                android:textColor="#332c2b"
                android:layout_toEndOf="@id/no2"/>



        <TextView
                android:lineSpacingExtra="5sp"
                android:layout_marginTop="10dp"
                android:layout_below="@id/krama_inggil_3"
                android:id="@+id/contoh_penggunaan_inggil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:text="@string/contoh_penggunaan_kramainggil"
                android:textColor="#332c2b" />

        <RelativeLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/contoh_penggunaan_inggil"
                        android:background="#fcffd9"
                        android:id="@+id/contoh_krama_inggil1"
                        android:layout_marginTop="5sp"
        >
            <ImageView
                    android:layout_gravity="top|start"
                    android:src="@drawable/contoh_1"
                    android:id="@+id/ic_contoh_krama_inggil_1"
                    android:layout_width="25dp"
                    android:layout_height="25dp"/>
            <TextView
                    android:layout_margin="5dp"
                    android:lineSpacingExtra="5sp"
                    android:id="@+id/contoh_krama_inggil_1"
                    android:layout_toRightOf="@id/ic_contoh_krama_inggil_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:text="@string/contoh_krama_inggil_1"
                    android:textColor="#00314c"/>
            <TextView
                    android:layout_margin="5dp"
                    android:lineSpacingExtra="5sp"
                    android:id="@+id/arti_contoh_krama_inggil_1"
                    android:layout_below="@id/contoh_krama_inggil_1"
                    android:layout_toRightOf="@id/ic_contoh_krama_inggil_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:text="@string/contoh_arti_krama_inggil_1"
                    android:textColor="#9a9a9a"/>
        </RelativeLayout>

        <RelativeLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/contoh_krama_inggil1"
                        android:background="#fcffd9"
                        android:id="@+id/contoh_krama_inggil2"
                        android:layout_marginTop="5sp"
        >
            <ImageView
                    android:layout_gravity="top|start"
                    android:src="@drawable/contoh_2"
                    android:id="@+id/ic_contoh_krama_inggil_2"
                    android:layout_width="25dp"
                    android:layout_height="25dp"/>
            <TextView
                    android:layout_margin="5dp"
                    android:lineSpacingExtra="5sp"
                    android:id="@+id/contoh_krama_inggil_2"
                    android:layout_toRightOf="@id/ic_contoh_krama_inggil_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:text="@string/contoh_krama_inggil_2"
                    android:textColor="#00314c"/>
            <TextView
                    android:layout_margin="5dp"
                    android:lineSpacingExtra="5sp"
                    android:id="@+id/arti_contoh_krama_inggil_2"
                    android:layout_below="@id/contoh_krama_inggil_2"
                    android:layout_toRightOf="@id/ic_contoh_krama_inggil_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:text="@string/contoh_arti_krama_inggil_2"
                    android:textColor="#9a9a9a"/>
        </RelativeLayout>

        <RelativeLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/contoh_krama_inggil2"
                        android:background="#fcffd9"
                        android:id="@+id/contoh_krama_inggil3"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="5dp"
        >
            <ImageView
                    android:layout_gravity="top|start"
                    android:src="@drawable/contoh_3"
                    android:id="@+id/ic_contoh_krama_inggil_3"
                    android:layout_width="25dp"
                    android:layout_height="25dp"/>
            <TextView
                    android:layout_margin="5dp"
                    android:lineSpacingExtra="5sp"
                    android:id="@+id/contoh_krama_inggil_3"
                    android:layout_toRightOf="@id/ic_contoh_krama_inggil_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:text="@string/contoh_krama_inggil_3"
                    android:textColor="#00314c"/>
            <TextView
                    android:layout_margin="5dp"
                    android:lineSpacingExtra="5sp"
                    android:id="@+id/arti_contoh_krama_inggil_3"
                    android:layout_below="@id/contoh_krama_inggil_3"
                    android:layout_toRightOf="@id/ic_contoh_krama_inggil_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:text="@string/contoh_arti_krama_inggil_3"
                    android:textColor="#9a9a9a"/>
        </RelativeLayout>


    </RelativeLayout>
</android.support.v4.widget.NestedScrollView>