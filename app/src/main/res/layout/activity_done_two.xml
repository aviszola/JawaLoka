<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                xmlns:tools="http://schemas.android.com/tools"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_done"
                tools:context=".activity.DoneTwo">

    <RelativeLayout android:layout_width="match_parent"
                    android:layout_height="420dp"
                    android:layout_margin="16dp"
                    android:layout_centerInParent="true"
                    android:background="@drawable/c_kalah"
                    android:id="@+id/card"
    >
        <TextView
                android:id="@+id/ucapan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:layout_marginTop="180dp"
                android:textSize="30sp"
                android:textColor="@android:color/white"
                android:text="Oops.. Maaf\nNilai Kamu"
        />

        <TextView android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:textAlignment="center"
                  android:layout_centerInParent="true"
                  android:layout_below="@id/ucapan"
                  android:textSize="80sp"
                  android:textColor="@android:color/white"
                  android:text="60"
                  android:id="@+id/txtTotalScore"
        />

    </RelativeLayout>
    <Button android:layout_width="250dp"
            android:layout_centerHorizontal="true"
            android:layout_height="wrap_content"
            android:text="Tutup"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:background="@drawable/bg_tutup"
            android:layout_below="@id/card"
            android:id="@+id/btnTryAgain"
    />


</RelativeLayout>