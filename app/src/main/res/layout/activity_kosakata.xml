<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/grey_bg"
        tools:context=".activity.KosakataActivity">
    <ImageView android:layout_width="150dp"
               android:layout_height="150dp"
               android:layout_alignParentBottom="true"
               android:layout_alignParentRight="true"
               android:layout_marginTop="20dp"
               android:background="@drawable/kosakata_bottom"
               android:layout_alignParentEnd="true"/>


    <RelativeLayout
            android:layout_width="match_parent"
            android:id="@+id/top"
            android:layout_height="match_parent">

        <LinearLayout android:layout_width="300dp"
                      android:layout_height="250dp"
                      android:background="@drawable/kosakata_top">

        </LinearLayout>

        <TextView
                android:id="@+id/icoback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:paddingLeft="20dp"
                android:textSize="30sp"
                android:drawableStart="@drawable/ic_arrow_back"
                android:textColor="@android:color/white"
                android:layout_marginTop="25dp"
                android:paddingStart="20dp"
                android:onClick="back"
                android:drawableLeft="@drawable/ic_arrow_back"/>
        <TextView
                android:id="@+id/hai"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kosa Kata"
                android:paddingLeft="20dp"
                android:textSize="25sp"
                android:layout_marginTop="10dp"
                android:textColor="@android:color/white"
                android:layout_below="@id/icoback"
                android:paddingStart="20dp"/>




        <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_below="@+id/hai"

        >
            <FrameLayout
                    android:id="@+id/kosakata_c1"
                    android:layout_width="match_parent"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginLeft="10dp"
                    android:layout_height="145dp"
                    android:background="@drawable/kosakata_c1"
                    />

            <FrameLayout
                    android:layout_below="@id/kosakata_c1"
                    android:id="@+id/kosakata_c2"
                    android:layout_width="match_parent"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginLeft="10dp"
                    android:layout_height="145dp"
                    android:background="@drawable/kosakata_c2"

            />

            <FrameLayout
                    android:layout_below="@id/kosakata_c2"
                    android:id="@+id/kosakata_c3"
                    android:layout_width="match_parent"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginLeft="10dp"
                    android:layout_height="145dp"
                    android:background="@drawable/kosakata_c3"

            />

        </RelativeLayout>

    </RelativeLayout>


</RelativeLayout>