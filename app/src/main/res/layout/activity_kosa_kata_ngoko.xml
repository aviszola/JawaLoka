<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        android:orientation="vertical"
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/grey_bg"
        tools:context=".activity.KosaKataNgokoActivity">



    <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:background="@drawable/bg_main_blue"
            android:layout_height="230dp">


        <TextView
                android:id="@+id/welcome"
                android:drawableStart="@drawable/ic_arrow_back"
                android:drawableLeft="@drawable/ic_arrow_back"
                android:drawablePadding="12dp"
                android:onClick="back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kosa Kata Ngoko"
                android:paddingLeft="10dp"
                android:textSize="18sp"
                android:textColor="@android:color/white"
                android:layout_marginTop="10dp"
                android:paddingStart="10dp" tools:ignore="RtlSymmetry"
        />
        <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="60dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:padding="10dp"
                android:background="@android:drawable/editbox_background_normal"
                android:id="@+id/linearLayout">

            <EditText
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/search"
                    android:drawableStart="@drawable/ic_search_24dp"
                    android:drawableLeft="@drawable/ic_search_24dp"
                    android:background="#ffffffff"
                    android:padding="10dp"
                    android:hint="Cari Kosa Kata"
                    android:maxLines="1"
                    android:minLines="1"
                    android:inputType="text"
                    android:imeOptions="actionSend"
            />
        </LinearLayout>



    </LinearLayout>

    <android.support.v7.widget.RecyclerView
            android:id="@+id/ourdoes"
            android:layout_width="match_parent"
            android:layout_marginTop="-40dp"
            android:layout_marginRight="16dp"
            android:layout_marginLeft="16dp"
            android:layout_height="wrap_content">

    </android.support.v7.widget.RecyclerView>

    <TextView
            android:id="@+id/endpage"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:layout_marginTop="20dp"
            android:text="Memuat Data..."
            android:textAlignment="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    <TextView
            android:id="@+id/gonepage"
            android:textSize="16sp"
            android:textColor="#9A9A9A"
            android:layout_marginTop="20dp"
            android:text="Tidak ada.."
            android:visibility="gone"
            android:textAlignment="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

</LinearLayout>