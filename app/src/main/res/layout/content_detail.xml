<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.NestedScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:context=".activity.PenggunaanNgokoActivity"
        tools:showIn="@layout/activity_penggunaan_ngoko">

    <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="16dp">

        <TextView
                android:lineSpacingExtra="5sp"
                android:id="@+id/definisi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:text="@string/definisi_ngoko"
                android:textColor="#332c2b" />

        <ImageView
                android:id="@+id/gambar_ngoko"
                android:layout_marginTop="10dp"
                android:layout_below="@id/definisi"
                android:layout_centerHorizontal="true"
                android:src="@drawable/gambar_ngoko"
                android:layout_width="352dp"
                android:layout_height="200dp"/>
        <TextView
                android:lineSpacingExtra="5sp"
                android:layout_marginTop="10dp"
                android:layout_below="@id/gambar_ngoko"
                android:id="@+id/ngoko_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:text="@string/ngoko_2"
                android:textColor="#332c2b" />
        <ImageView

                android:layout_marginTop="15dp"
                android:layout_below="@id/ngoko_2"
                android:src="@drawable/no_1"
                android:id="@+id/no1"
                android:layout_width="25dp"
                android:layout_height="25dp"/>
        <TextView
                android:layout_marginLeft="5sp"
                android:layout_marginTop="15dp"
                android:layout_toRightOf="@id/no1"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/ngoko_2"
                android:id="@+id/contoh1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:text="Ngoko Lugu"
                android:textColor="#00314c"
                android:layout_toEndOf="@id/no1"/>
        <TextView
                android:layout_margin="5dp"
                android:layout_toRightOf="@id/no1"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/contoh1"
                android:id="@+id/ngoko_lugu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:text="@string/ngoko_lugu"
                android:textColor="#332c2b"
                android:layout_toEndOf="@id/no1"/>
        <TextView
                android:layout_margin="5dp"
                android:padding="5sp"
                android:layout_toRightOf="@id/no1"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/ngoko_lugu"
                android:id="@+id/ngoko_lugu_1"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:textSize="13sp"
                android:background="#d9f1ff"
                android:text="1. Teman yang sudah akrab"
                android:textColor="#332c2b"
                android:layout_toEndOf="@id/no1"/>
        <TextView
                android:layout_margin="5dp"
                android:padding="5sp"
                android:layout_toRightOf="@id/no1"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/ngoko_lugu_1"
                android:id="@+id/ngoko_lugu_2"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:textSize="13sp"
                android:background="#d9f1ff"
                android:text="2. Orang yang kedudukan derajatnya lebih rendah"
                android:textColor="#332c2b"
                android:layout_toEndOf="@id/no1"/>
        <TextView
                android:layout_margin="5dp"
                android:padding="5sp"
                android:layout_toRightOf="@id/no1"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/ngoko_lugu_2"
                android:id="@+id/ngoko_lugu_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:background="#d9f1ff"
                android:text="3. Untuk situasi formal (resmi) yang harus menggunakan ragam basa ngoko (tulisan di majalah ataupun buku). "
                android:textColor="#332c2b"
                android:layout_toEndOf="@id/no1"/>
        <TextView
                android:lineSpacingExtra="5sp"
                android:layout_marginTop="10dp"
                android:layout_below="@id/ngoko_lugu_3"
                android:id="@+id/contoh_penggunaan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:text="@string/contoh_penggunaan_ngoko"
                android:textColor="#332c2b" />

        <RelativeLayout android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:layout_below="@id/contoh_penggunaan"
                      android:background="#fcffd9"
                        android:id="@+id/contoh_ngoko_lugu1"
                        android:layout_marginTop="5sp"
        >
            <ImageView
                    android:layout_gravity="top|start"
                    android:src="@drawable/contoh_1"
                    android:id="@+id/ic_contoh_1"
                    android:layout_width="25dp"
                    android:layout_height="25dp"/>
            <TextView
                    android:layout_margin="5dp"
                    android:lineSpacingExtra="5sp"
                    android:id="@+id/contoh_ngoko_1"
                    android:layout_toRightOf="@id/ic_contoh_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:text="@string/contoh_ngoko_1"
                    android:textColor="#00314c"/>
            <TextView
                    android:layout_margin="5dp"
                    android:lineSpacingExtra="5sp"
                    android:id="@+id/arti_contoh_ngoko_1"
                    android:layout_below="@id/contoh_ngoko_1"
                    android:layout_toRightOf="@id/ic_contoh_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:text="@string/arti_contoh_ngoko_1"
                    android:textColor="#9a9a9a"/>

        </RelativeLayout>

        <RelativeLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/contoh_ngoko_lugu1"
                        android:background="#fcffd9"
                        android:id="@+id/contoh_ngoko_lugu2"
                        android:layout_marginTop="5sp"
        >
            <ImageView
                    android:layout_gravity="top|start"
                    android:src="@drawable/contoh_2"
                    android:id="@+id/ic_contoh_2"
                    android:layout_width="25dp"
                    android:layout_height="25dp"/>
            <TextView
                    android:layout_margin="5dp"
                    android:lineSpacingExtra="5sp"
                    android:id="@+id/contoh_ngoko_2"
                    android:layout_toRightOf="@id/ic_contoh_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:text="@string/contoh_ngoko_2"
                    android:textColor="#00314c"/>
            <TextView
                    android:layout_margin="5dp"
                    android:lineSpacingExtra="5sp"
                    android:id="@+id/arti_contoh_ngoko_2"
                    android:layout_below="@id/contoh_ngoko_2"
                    android:layout_toRightOf="@id/ic_contoh_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:text="@string/arti_contoh_ngoko_2"
                    android:textColor="#9a9a9a"/>

        </RelativeLayout>

        <RelativeLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/contoh_ngoko_lugu2"
                        android:background="#fcffd9"
                        android:id="@+id/contoh_ngoko_lugu3"
                        android:layout_marginTop="5sp"
        >
            <ImageView
                    android:layout_gravity="top|start"
                    android:src="@drawable/contoh_3"
                    android:id="@+id/ic_contoh_3"
                    android:layout_width="25dp"
                    android:layout_height="25dp"/>
            <TextView
                    android:layout_margin="5dp"
                    android:lineSpacingExtra="5sp"
                    android:id="@+id/contoh_ngoko_3"
                    android:layout_toRightOf="@id/ic_contoh_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:text="@string/contoh_ngoko_3"
                    android:textColor="#00314c"/>
            <TextView
                    android:layout_margin="5dp"
                    android:lineSpacingExtra="5sp"
                    android:id="@+id/arti_contoh_ngoko_3"
                    android:layout_below="@id/contoh_ngoko_3"
                    android:layout_toRightOf="@id/ic_contoh_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:text="@string/arti_contoh_ngoko_3"
                    android:textColor="#9a9a9a"/>
        </RelativeLayout>

        <!---->
        <!--B A T A S KNFNVJNDFJNJVNJSVNDFJKVKJVNSJKDVNJKSDVJKVJKVNDVNJK-->

        <ImageView
                android:layout_marginTop="15dp"
                android:layout_below="@id/contoh_ngoko_lugu3"
                android:src="@drawable/no_2"
                android:id="@+id/no2"
                android:layout_width="25dp"
                android:layout_height="25dp"/>
        <TextView
                android:layout_marginTop="15dp"
                android:layout_marginLeft="5dp"
                android:layout_toRightOf="@id/no2"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/contoh_ngoko_lugu3"
                android:id="@+id/contoh2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:text="Ngoko Alus"
                android:textColor="#00314c"
                android:layout_toEndOf="@id/no2"/>
        <TextView
                android:layout_margin="5dp"
                android:layout_toRightOf="@id/no2"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/contoh2"
                android:id="@+id/ngoko_alus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:text="@string/ngoko_alus"
                android:textColor="#332c2b"
                android:layout_toEndOf="@id/no2"/>
        <TextView
                android:layout_margin="5dp"
                android:padding="5sp"
                android:layout_toRightOf="@id/no2"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/ngoko_alus"
                android:id="@+id/ngoko_alus_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:background="#d9f1ff"
                android:text="1. Teman yang sudah akrab tapi saling menghormati (saling mempunyai pangkat atau jabatan)"
                android:textColor="#332c2b"
                android:layout_toEndOf="@id/no2"/>

        <TextView
                android:layout_margin="5dp"
                android:padding="5sp"
                android:layout_toRightOf="@id/no2"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/ngoko_alus_1"
                android:id="@+id/ngoko_alus_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:background="#d9f1ff"
                android:text="2. Orang tua yang lebih tinggi derajatnya, tetapi sudah sangat akrab"
                android:textColor="#332c2b"
                android:layout_toEndOf="@id/no2"/>

        <TextView
                android:layout_margin="5dp"
                android:padding="5sp"
                android:layout_toRightOf="@id/no2"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/ngoko_alus_2"
                android:id="@+id/ngoko_alus_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:background="#d9f1ff"
                android:text="3. Ketika bermusyawarah dengan orang yang dihormati"
                android:textColor="#332c2b"
                android:layout_toEndOf="@id/no2"/>

        <TextView
                android:layout_margin="5dp"
                android:padding="5sp"
                android:layout_toRightOf="@id/no2"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/ngoko_alus_3"
                android:id="@+id/ngoko_alus_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:background="#d9f1ff"
                android:text="4. Tulisan di majalah untuk menghormati pembaca"
                android:textColor="#332c2b"
                android:layout_toEndOf="@id/no2"/>

        <TextView
                android:lineSpacingExtra="5sp"
                android:layout_marginTop="10dp"
                android:layout_below="@id/ngoko_alus_4"
                android:id="@+id/contoh_penggunaan_alus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:text="@string/contoh_penggunaan_ngokoalus"
                android:textColor="#332c2b" />

        <RelativeLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/contoh_penggunaan_alus"
                        android:background="#fcffd9"
                        android:id="@+id/contoh_ngoko_alus1"
                        android:layout_marginTop="5sp"
        >
            <ImageView
                    android:layout_gravity="top|start"
                    android:src="@drawable/contoh_1"
                    android:id="@+id/ic_contoh_alus_1"
                    android:layout_width="25dp"
                    android:layout_height="25dp"/>
            <TextView
                    android:layout_margin="5dp"
                    android:lineSpacingExtra="5sp"
                    android:id="@+id/contoh_ngoko_alus_1"
                    android:layout_toRightOf="@id/ic_contoh_alus_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:text="@string/contoh_ngoko_alus_1"
                    android:textColor="#00314c"/>
            <TextView
                    android:layout_margin="5dp"
                    android:lineSpacingExtra="5sp"
                    android:id="@+id/arti_contoh_ngoko_alus_1"
                    android:layout_below="@id/contoh_ngoko_alus_1"
                    android:layout_toRightOf="@id/ic_contoh_alus_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:text="@string/contoh_arti_ngoko_alus_1"
                    android:textColor="#9a9a9a"/>
        </RelativeLayout>
        <RelativeLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/contoh_ngoko_alus1"
                        android:background="#fcffd9"
                        android:id="@+id/contoh_ngoko_alus2"
                        android:layout_marginTop="5sp"
        >
            <ImageView
                    android:layout_gravity="top|start"
                    android:src="@drawable/contoh_2"
                    android:id="@+id/ic_contoh_alus_2"
                    android:layout_width="25dp"
                    android:layout_height="25dp"/>
            <TextView
                    android:layout_margin="5dp"
                    android:lineSpacingExtra="5sp"
                    android:id="@+id/contoh_ngoko_alus_2"
                    android:layout_toRightOf="@id/ic_contoh_alus_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:text="@string/contoh_ngoko_alus_2"
                    android:textColor="#00314c"/>
            <TextView
                    android:layout_margin="5dp"
                    android:lineSpacingExtra="5sp"
                    android:id="@+id/arti_contoh_ngoko_alus_2"
                    android:layout_below="@id/contoh_ngoko_alus_2"
                    android:layout_toRightOf="@id/ic_contoh_alus_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:text="@string/contoh_arti_ngoko_alus_2"
                    android:textColor="#9a9a9a"/>
        </RelativeLayout>
        <RelativeLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/contoh_ngoko_alus2"
                        android:background="#fcffd9"
                        android:id="@+id/contoh_ngoko_alus3"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="5dp"
        >
            <ImageView
                    android:layout_gravity="top|start"
                    android:src="@drawable/contoh_3"
                    android:id="@+id/ic_contoh_alus_3"
                    android:layout_width="25dp"
                    android:layout_height="25dp"/>
            <TextView
                    android:layout_margin="5dp"
                    android:lineSpacingExtra="5sp"
                    android:id="@+id/contoh_ngoko_alus_3"
                    android:layout_toRightOf="@id/ic_contoh_alus_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:text="@string/contoh_ngoko_alus_3"
                    android:textColor="#00314c"/>
            <TextView
                    android:layout_margin="5dp"
                    android:lineSpacingExtra="5sp"
                    android:id="@+id/arti_contoh_ngoko_alus_3"
                    android:layout_below="@id/contoh_ngoko_alus_3"
                    android:layout_toRightOf="@id/ic_contoh_alus_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:text="@string/contoh_arti_ngoko_alus_3"
                    android:textColor="#9a9a9a"/>
        </RelativeLayout>

    </RelativeLayout>
</android.support.v4.widget.NestedScrollView>