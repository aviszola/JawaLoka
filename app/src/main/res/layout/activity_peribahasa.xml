<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
        android:orientation="vertical"
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/grey_bg"
        tools:context=".activity.PeribahasaActivity">

    <RelativeLayout
            android:id="@+id/top"
            android:layout_width="match_parent"
            android:background="@drawable/peribahasa_bg"
            android:layout_height="180dp">



        <TextView
                android:id="@+id/welcome"
                android:drawableStart="@drawable/ic_arrow_back"
                android:drawableLeft="@drawable/ic_arrow_back"
                android:drawablePadding="12dp"
                android:onClick="back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Peribahasa"
                android:paddingLeft="10dp"
                android:textSize="18sp"
                android:textColor="@android:color/white"
                android:layout_marginTop="10dp"
                android:paddingStart="10dp" tools:ignore="RtlSymmetry"
        />
        <ImageView android:layout_width="160dp"
                   android:layout_height="180dp"
                   android:layout_alignParentRight="true"
                   android:id="@+id/circle"
                   android:background="@drawable/peribahasa_circle"
                   android:layout_alignParentEnd="true"/>
        <LinearLayout

                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="70dp"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"
                android:padding="10dp"
                android:background="@android:drawable/editbox_background_normal"
                android:id="@+id/linearLayout">


            <EditText
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/search"
                    android:drawableStart="@drawable/ic_search_24dp"
                    android:drawableLeft="@drawable/ic_search_24dp"
                    android:background="#ffffffff"
                    android:padding="10dp"
                    android:hint="Cari Peribahasa"
                    android:maxLines="1"
                    android:minLines="1"
                    android:inputType="textCapSentences"
                    android:imeOptions="actionSend"
            />
        </LinearLayout>



    </RelativeLayout>

    <android.support.v7.widget.RecyclerView
            android:layout_marginTop="10dp"
            android:layout_below="@+id/top"
            android:id="@+id/ourdoes"
            android:layout_width="match_parent"
            android:layout_marginRight="16dp"
            android:layout_marginLeft="16dp"
            android:layout_height="wrap_content">

    </android.support.v7.widget.RecyclerView>

    <TextView
            android:layout_below="@+id/ourdoes"
            android:id="@+id/endpage"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:layout_marginTop="20dp"
            android:text="Memuat Data..."
            android:textAlignment="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    <TextView
            android:id="@+id/gonepage"
            android:textSize="16sp"
            android:textColor="#9A9A9A"
            android:layout_marginTop="20dp"
            android:text="Tidak ada.."
            android:visibility="gone"
            android:textAlignment="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

</RelativeLayout>