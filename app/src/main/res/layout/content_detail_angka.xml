<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.NestedScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:context=".activity.PenggunaanAngkaActivity"
        tools:showIn="@layout/activity_penggunaan_angka">

    <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="16dp">

        <TextView
                android:lineSpacingExtra="5sp"
                android:id="@+id/definisi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:text="@string/definisi_angka"
                android:textColor="#332c2b" />


        <ImageView

                android:layout_marginTop="15dp"
                android:layout_below="@id/definisi"
                android:src="@drawable/no_1"
                android:id="@+id/no1"
                android:layout_width="25dp"
                android:layout_height="25dp"/>
        <TextView
                android:layout_marginLeft="5sp"
                android:layout_marginTop="15dp"
                android:layout_toRightOf="@id/no1"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/definisi"
                android:id="@+id/contoh1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:text="Menyebut angka 1 - 0"
                android:textColor="#00314c"
                android:layout_toEndOf="@id/no1"/>
        <TextView
                android:layout_margin="5dp"
                android:layout_toRightOf="@id/no1"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/contoh1"
                android:id="@+id/angka110"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:text="@string/angka110"
                android:textColor="#332c2b"
                android:layout_toEndOf="@id/no1"/>
        <TextView
                android:layout_margin="5dp"
                android:padding="5sp"
                android:layout_toRightOf="@id/no1"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/angka110"
                android:id="@+id/angka_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:background="#d9f1ff"
                android:text="1. (Siji/Setunggal) = Esa + Eka + Ika + Tunggal (Keagungan Tuhan), dll."
                android:textColor="#332c2b"
                android:layout_toEndOf="@id/no1"/>
        <TextView
                android:layout_margin="5dp"
                android:padding="5sp"
                android:layout_toRightOf="@id/no1"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/angka_1"
                android:id="@+id/angka_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:background="#d9f1ff"
                android:text="2. Loro/Roro/Kalih/Rwa) = Dwi (dua yang menyatu/keseimbangan), Tengen(tangan), , dll"
                android:textColor="#332c2b"
                android:layout_toEndOf="@id/no1"/>
        <TextView
                android:layout_margin="5dp"
                android:padding="5sp"
                android:layout_toRightOf="@id/no1"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/angka_2"
                android:id="@+id/angka_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:background="#d9f1ff"
                android:text="3. (Telu/Tigo/Tri) = Tri (tiga kehidupan; Alam Ruh/Kandungan, Duniawi, Akherat), dll."
                android:textColor="#332c2b"
                android:layout_toEndOf="@id/no1"/>

        <TextView
                android:layout_margin="5dp"
                android:padding="5sp"
                android:layout_toRightOf="@id/no1"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/angka_3"
                android:id="@+id/angka_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:background="#d9f1ff"
                android:text="4. (Papat/Sekawan) = Catur (kreatifitas, kecerdasan), Kerta (kemenangan), dll."
                android:textColor="#332c2b"
                android:layout_toEndOf="@id/no1"/>

        <TextView
                android:layout_margin="5dp"
                android:padding="5sp"
                android:layout_toRightOf="@id/no1"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/angka_4"
                android:id="@+id/angka_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:background="#d9f1ff"
                android:text="5. (Limo/Gangsal) = Panca (kekuatan diri), Astra (kesaktian), dll."
                android:textColor="#332c2b"
                android:layout_toEndOf="@id/no1"/>
        <TextView
                android:layout_margin="5dp"
                android:padding="5sp"
                android:layout_toRightOf="@id/no1"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/angka_5"
                android:id="@+id/angka_6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:background="#d9f1ff"
                android:text="6. (Enem) = Rasa (empati, simpati), Bremana (arif, bijaksana), dll."
                android:textColor="#332c2b"
                android:layout_toEndOf="@id/no1"/>

        <TextView
                android:layout_margin="5dp"
                android:padding="5sp"
                android:layout_toRightOf="@id/no1"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/angka_6"
                android:id="@+id/angka_7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:background="#d9f1ff"
                android:text="7. (Pitu) = Sapta (hukum), Sinangga (menjaga/menjunjung tinggi drajat dan kehormatan), dll."
                android:textColor="#332c2b"
                android:layout_toEndOf="@id/no1"/>

        <TextView
                android:layout_margin="5dp"
                android:padding="5sp"
                android:layout_toRightOf="@id/no1"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/angka_7"
                android:id="@+id/angka_8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:background="#d9f1ff"
                android:text="8. (Wolu) = Asta (kebajikan), Naga (simbol kewibawaan), dll."
                android:textColor="#332c2b"
                android:layout_toEndOf="@id/no1"/>

        <TextView
                android:layout_margin="5dp"
                android:padding="5sp"
                android:layout_toRightOf="@id/no1"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/angka_8"
                android:id="@+id/angka_9"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:background="#d9f1ff"
                android:text="9. (Songo) = Nawa (semangat dan simbol kemuliaan), Hanggatra (kesempurnaan), dll."
                android:textColor="#332c2b"
                android:layout_toEndOf="@id/no1"/>
        <TextView
                android:layout_margin="5dp"
                android:padding="5sp"
                android:layout_toRightOf="@id/no1"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/angka_9"
                android:id="@+id/angka_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:background="#d9f1ff"
                android:text="0. (Nul) = Ilang (hilang), Sirna (musnah), Sonya (kosong), Pungkasan (akhir) dll."
                android:textColor="#332c2b"
                android:layout_toEndOf="@id/no1"/>
        <ImageView

                android:layout_marginTop="15dp"
                android:layout_below="@id/angka_0"
                android:src="@drawable/no_2"
                android:id="@+id/no2"
                android:layout_width="25dp"
                android:layout_height="25dp"/>
        <TextView
                android:layout_marginLeft="5sp"
                android:layout_marginTop="15dp"
                android:layout_toRightOf="@id/no2"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/angka_0"
                android:id="@+id/contoh2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:text="Menyebut angka 11 - 19"
                android:textColor="#00314c"
                android:layout_toEndOf="@id/no2"/>

        <TextView
                android:layout_margin="5dp"
                android:layout_toRightOf="@id/no2"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/contoh2"
                android:id="@+id/angka1119"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:text="@string/angka1119"
                android:textColor="#332c2b"
                android:layout_toEndOf="@id/no2"/>
        <ImageView
                android:id="@+id/gambar_contoh2"
                android:layout_marginTop="10dp"
                android:layout_below="@id/angka1119"
                android:layout_centerHorizontal="true"
                android:src="@drawable/gambar_contoh2"
                android:layout_width="350dp"
                android:layout_height="200dp"
                android:layout_toEndOf="@id/no2"
                android:layout_toRightOf="@id/no2"/>
        <TextView
                android:layout_margin="5dp"
                android:layout_toRightOf="@id/no2"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/gambar_contoh2"
                android:id="@+id/angka11"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:text="@string/angka11"
                android:textColor="#332c2b"
                android:layout_toEndOf="@id/no2"/>

        <ImageView

                android:layout_marginTop="15dp"
                android:layout_below="@id/angka11"
                android:src="@drawable/no_3"
                android:id="@+id/no3"
                android:layout_width="25dp"
                android:layout_height="25dp"/>
        <TextView
                android:layout_marginLeft="5sp"
                android:layout_marginTop="15dp"
                android:layout_toRightOf="@id/no3"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/angka11"
                android:id="@+id/contoh3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:text="Menyebut angka 20 - 29"
                android:textColor="#00314c"
                android:layout_toEndOf="@id/no3"/>

        <TextView
                android:layout_margin="5dp"
                android:layout_toRightOf="@id/no3"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/contoh3"
                android:id="@+id/angka2029"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:text="@string/angka2029"
                android:textColor="#332c2b"
                android:layout_toEndOf="@id/no3"/>
        <ImageView
                android:id="@+id/gambar_contoh3"
                android:layout_marginTop="10dp"
                android:layout_below="@id/angka2029"
                android:layout_centerHorizontal="true"
                android:src="@drawable/gambar_contoh3"
                android:layout_width="350dp"
                android:layout_height="200dp"
                android:layout_toEndOf="@id/no3"
                android:layout_toRightOf="@id/no3"/>

        <TextView
                android:layout_margin="5dp"
                android:layout_toRightOf="@id/no3"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/gambar_contoh3"
                android:id="@+id/angka20"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:text="@string/angka20"
                android:textColor="#332c2b"
                android:layout_toEndOf="@id/no3"/>
        <ImageView

                android:layout_marginTop="15dp"
                android:layout_below="@id/angka20"
                android:src="@drawable/no_4"
                android:id="@+id/no4"
                android:layout_width="25dp"
                android:layout_height="25dp"/>
        <TextView
                android:layout_marginLeft="5sp"
                android:layout_marginTop="15dp"
                android:layout_toRightOf="@id/no4"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/angka20"
                android:id="@+id/contoh4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:text="Menyebut angka 50"
                android:textColor="#00314c"
                android:layout_toEndOf="@id/no4"/>

        <TextView
                android:layout_margin="5dp"
                android:layout_toRightOf="@id/no4"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/contoh4"
                android:id="@+id/angka5050"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:text="@string/angka5050"
                android:textColor="#332c2b"
                android:layout_toEndOf="@id/no4"/>
        <ImageView
                android:id="@+id/gambar_contoh4"
                android:layout_marginTop="10dp"
                android:layout_below="@id/angka5050"
                android:layout_centerHorizontal="true"
                android:src="@drawable/gambar_contoh4"
                android:layout_width="350dp"
                android:layout_height="200dp"
                android:layout_toEndOf="@id/no4"
                android:layout_toRightOf="@id/no4"/>
        <TextView
                android:layout_margin="5dp"
                android:layout_toRightOf="@id/no4"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/gambar_contoh4"
                android:id="@+id/angka50"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:text="@string/angka50"
                android:textColor="#332c2b"
                android:layout_toEndOf="@id/no4"/>

        <ImageView

                android:layout_marginTop="15dp"
                android:layout_below="@id/angka50"
                android:src="@drawable/no_5"
                android:id="@+id/no5"
                android:layout_width="25dp"
                android:layout_height="25dp"/>

        <TextView
                android:layout_marginLeft="5sp"
                android:layout_marginTop="15dp"
                android:layout_toRightOf="@id/no5"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/angka50"
                android:id="@+id/contoh5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:text="Menyebut angka 60"
                android:textColor="#00314c"
                android:layout_toEndOf="@id/no5"/>
        <TextView
                android:layout_margin="5dp"
                android:layout_toRightOf="@id/no5"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/contoh5"
                android:id="@+id/angka6060"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:text="@string/angka6060"
                android:textColor="#332c2b"
                android:layout_toEndOf="@id/no5"/>
        <ImageView
                android:id="@+id/gambar_contoh5"
                android:layout_marginTop="10dp"
                android:layout_below="@id/angka6060"
                android:layout_centerHorizontal="true"
                android:src="@drawable/gambar_contoh5"
                android:layout_width="350dp"
                android:layout_height="200dp"
                android:layout_toEndOf="@id/no5"
                android:layout_toRightOf="@id/no5"/>
        <TextView
                android:layout_margin="5dp"
                android:layout_toRightOf="@id/no5"
                android:lineSpacingExtra="5sp"
                android:layout_below="@id/gambar_contoh5"
                android:id="@+id/angka60"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:text="@string/angka60"
                android:textColor="#332c2b"
                android:layout_toEndOf="@id/no5"/>


    </RelativeLayout>
</android.support.v4.widget.NestedScrollView>