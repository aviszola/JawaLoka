<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/grey_bg"
        tools:context=".activity.PenggunaanBahasaJawaActivity">

    <RelativeLayout
            android:layout_width="match_parent"
            android:id="@+id/top"
            android:layout_height="wrap_content">

        <LinearLayout
                android:layout_width="match_parent"
                      android:layout_height="300dp"
                      android:background="@drawable/bg_implementasi"
                android:id="@+id/topbg"
                android:orientation="horizontal"/>


        <TextView
                android:id="@+id/welcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:paddingLeft="20dp"
                android:textSize="18sp"
                android:textColor="@android:color/white"
                android:layout_marginTop="15dp"
                android:drawableStart="@drawable/ic_arrow_back"
                android:paddingStart="20dp"
                android:onClick="back"
                android:drawableLeft="@drawable/ic_arrow_back"/>
        <TextView
                android:id="@+id/hai"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Penggunaan\nBahasa Jawa"
                android:paddingLeft="20dp"
                android:textSize="25sp"
                android:layout_marginTop="10dp"
                android:textColor="@android:color/white"
                android:layout_below="@id/welcome"
                android:paddingStart="20dp"/>


        <ImageView android:layout_width="150dp"
                   android:layout_height="150dp"
                   android:layout_alignParentRight="true"
                   android:id="@+id/circle"
                   android:background="@drawable/circle_implementasi"
                   android:layout_alignParentEnd="true"/>


        <android.support.v4.view.ViewPager
                android:layout_below="@+id/hai"
                android:id="@+id/viewPager"
                android:overScrollMode="never"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="500dp">
        </android.support.v4.view.ViewPager>

        <com.tbuonomo.viewpagerdotsindicator.WormDotsIndicator
                android:id="@+id/dots_indicator"
                android:layout_below="@id/viewPager"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                app:dotsColor="@color/colorPrimary"
                app:dotsCornerRadius="8dp"
                android:layout_marginTop="-20dp"
                app:dotsSize="16dp"
                app:dotsSpacing="6dp"
                app:dotsWidthFactor="2.5"
        />


    </RelativeLayout>

<ImageView android:layout_width="match_parent"
           android:layout_height="80dp"
           android:layout_alignParentBottom="true"
           android:layout_marginBottom="-5dp"
           android:src="@drawable/implementasi_bottom"
/>


</RelativeLayout>