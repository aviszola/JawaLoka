<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                xmlns:tools="http://schemas.android.com/tools"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/white"
                tools:context=".activity.StartTwoActivity">

    <ImageView android:layout_width="180dp"
               android:layout_height="150dp"
               android:layout_alignParentRight="true"
               android:layout_alignParentTop="true"
               android:src="@drawable/top"
               android:id="@+id/top"
    />

    <ImageView android:layout_width="match_parent"
               android:layout_marginTop="20dp"
               android:layout_height="200dp"
               android:layout_below="@id/top"
               android:src="@drawable/g_play"
               android:id="@+id/gplay"
    />

    <TextView android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_below="@id/gplay"
              android:id="@+id/yakin"
              android:textSize="30sp"
              android:text="Ayo rek mulai !"
              android:textAlignment="center"
              android:layout_margin="16dp"
              android:textColor="#040a51"
    />

    <Button
            android:id="@+id/btnMain"
            android:layout_marginRight="16dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="20dp"
            android:layout_below="@id/yakin"
            android:layout_centerInParent="true"
            android:text="Main"
            android:textColor="#FFF"
            android:textAllCaps="false"
            android:background="@drawable/play"
            android:textSize="30sp"
            android:layout_width="300dp"
            android:layout_height="wrap_content" />


    <ImageView android:layout_width="180dp"
               android:layout_height="150dp"
               android:layout_alignParentLeft="true"
               android:layout_alignParentBottom="true"
               android:src="@drawable/bottom"
               android:id="@+id/bottom"
    />



</RelativeLayout>