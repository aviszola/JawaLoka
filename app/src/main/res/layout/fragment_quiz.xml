<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.NestedScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/grey_bg"
        tools:context=".fragment.BelajarFragment">

    <RelativeLayout
            android:layout_width="match_parent"
            android:id="@+id/top"
            android:layout_height="wrap_content">



        <LinearLayout android:layout_width="match_parent"
                      android:layout_height="245dp"
                      android:background="@drawable/bg_kuis"
                      android:layout_marginTop="-1dp"
        >
        </LinearLayout>
        <ImageView android:layout_width="125dp"
                   android:layout_height="220dp"
                   android:layout_marginTop="20dp"
                   android:background="@drawable/bowo_quiz"
                   android:layout_marginRight="43dp"
                   android:layout_alignParentRight="true"
                   android:layout_alignParentEnd="true"/>

        <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kuis"
                android:layout_marginLeft="18dp"
                android:textSize="30sp"
                android:textColor="@android:color/white"
                android:layout_marginTop="25dp"/>

        <TextView
                android:id="@+id/quote_kuis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="He rek ayo kene\nnggarap bareng !"
                android:textSize="15sp"
                android:layout_marginLeft="20dp"
                android:textColor="@android:color/white"
                android:layout_below="@id/title"/>


        <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="140dp"
                android:layout_below="@+id/title"

        >
            <FrameLayout
                    android:id="@+id/level1"
                    android:layout_width="match_parent"
                    android:layout_marginRight="10dp"
                    android:layout_marginLeft="10dp"
                    android:layout_height="150dp"
                    android:background="@drawable/level_1"
            >
               <LinearLayout android:layout_width="match_parent"
                             android:layout_height="wrap_content">

                   <TextView android:layout_width="wrap_content"
                             android:layout_height="wrap_content"
                             android:textColor="@android:color/white"
                             android:text=""
                   />

               </LinearLayout>

            </FrameLayout>

            <FrameLayout
                    android:layout_below="@id/level1"
                    android:id="@+id/level2"
                    android:layout_width="match_parent"
                    android:layout_marginRight="10dp"
                    android:layout_marginLeft="10dp"
                    android:layout_height="150dp"
                    android:background="@drawable/level_2"

            />

            <FrameLayout
                    android:layout_below="@id/level2"
                    android:id="@+id/level3"
                    android:layout_width="match_parent"
                    android:layout_marginRight="10dp"
                    android:layout_marginLeft="10dp"
                    android:layout_height="150dp"
                    android:background="@drawable/level_3"

            />

        </RelativeLayout>

    </RelativeLayout>


</android.support.v4.widget.NestedScrollView>