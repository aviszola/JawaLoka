<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.NestedScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/grey_bg"
        tools:context=".fragment.MoreFragment">

    <RelativeLayout
            android:layout_width="match_parent"
            android:id="@+id/top"

            android:layout_height="wrap_content">

        <LinearLayout android:layout_width="match_parent"
                      android:layout_height="210dp"
                      android:background="@drawable/bg_tentang"
        >

        </LinearLayout>

        <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tentang Kami"
                android:paddingLeft="20dp"
                android:textSize="30sp"
                android:textColor="@android:color/white"
                android:layout_marginTop="25dp"
                android:paddingStart="20dp"/>

        <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_below="@+id/title"

        >
            <FrameLayout
                    android:id="@+id/tentang_aplikasi"
                    android:layout_width="match_parent"
                    android:layout_marginRight="10dp"
                    android:layout_marginLeft="10dp"
                    android:layout_height="400dp"
                    android:background="@drawable/card_penjelasan"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"

            />

            <FrameLayout
                    android:id="@+id/hafiz"
                    android:layout_below="@+id/tentang_aplikasi"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:background="@drawable/hafiz"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    />
            <FrameLayout
                    android:id="@+id/tata"
                    android:layout_below="@+id/hafiz"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:background="@drawable/tata"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
            />
            <FrameLayout
                    android:id="@+id/ucup"
                    android:layout_below="@+id/tata"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:background="@drawable/ucup"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
            />
            <FrameLayout
                    android:id="@+id/credit"
                    android:layout_below="@+id/ucup"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:background="@drawable/btn_credit"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="5sp"
            />

        </RelativeLayout>

    </RelativeLayout>



</android.support.v4.widget.NestedScrollView>