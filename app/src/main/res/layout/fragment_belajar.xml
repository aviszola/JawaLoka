<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.NestedScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/grey_bg"
        tools:context=".fragment.BelajarFragment">

    <RelativeLayout
            android:layout_width="match_parent"
            android:id="@+id/top"

            android:layout_height="wrap_content">

        <LinearLayout android:layout_width="match_parent"
                      android:layout_height="220dp"
                      android:background="@drawable/bg_main_blue"
        >

        </LinearLayout>

        <TextView
                android:id="@+id/title_belajar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Belajar"
                android:textSize="30sp"
                android:layout_marginLeft="18dp"
                android:textColor="@android:color/white"
                android:layout_marginTop="25dp"/>
        <TextView
                android:id="@+id/quote_belajar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="He rek ayo kene \nsinau bareng !"
                android:textSize="15sp"
                android:layout_marginLeft="20dp"
                android:textColor="@android:color/white"
                android:layout_below="@id/title_belajar"/>

        <ImageView android:layout_width="170dp"
                   android:layout_height="170dp"
                   android:layout_alignParentRight="true"
                   android:background="@drawable/ilustrasi_belajar"
                   android:layout_alignParentEnd="true"/>


        <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="60dp"
                android:layout_below="@+id/quote_belajar"

        >
            <FrameLayout
                    android:id="@+id/belajar_c1"
                    android:layout_width="match_parent"
                    android:layout_marginRight="8dp"
                    android:layout_marginLeft="88dp"
                    android:layout_height="130dp"
                    android:background="@drawable/belajar_c1rev"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"/>

            <FrameLayout
                    android:layout_below="@id/belajar_c1"
                    android:id="@+id/belajar_c2"
                    android:layout_width="match_parent"
                    android:layout_marginRight="8dp"
                    android:layout_marginLeft="8dp"
                    android:layout_height="130dp"
                    android:background="@drawable/belajar_c2rev"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
            />

            <FrameLayout
                    android:layout_below="@id/belajar_c2"
                    android:id="@+id/belajar_c3"
                    android:layout_width="match_parent"
                    android:layout_marginRight="8dp"
                    android:layout_marginLeft="8dp"
                    android:layout_height="130dp"
                    android:background="@drawable/belajar_c3rev"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
            />

            <FrameLayout
                    android:layout_below="@id/belajar_c3"
                    android:id="@+id/belajar_c4"
                    android:layout_width="match_parent"
                    android:layout_marginRight="8dp"
                    android:layout_marginLeft="8dp"
                    android:layout_height="130dp"
                    android:background="@drawable/belajar_c4rev"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"

            />
        </RelativeLayout>

    </RelativeLayout>


</android.support.v4.widget.NestedScrollView>